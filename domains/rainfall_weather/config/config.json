{
  "domain": "rainfall_weather",
  "study_area": {
    "name": "Thiruvananthapuram Coast, Kerala, India",
    "center_lat": 8.462,
    "center_lon": 76.926
  },
  "intended_real_sources": {
    "rainfall": {
      "name": "GPM IMERG Final Run",
      "provider": "NASA",
      "url": "https://gpm.nasa.gov/data/imerg",
      "resolution_temporal": "30min",
      "units": "mm/hr"
    },
    "weather": {
      "name": "ERA5 Reanalysis",
      "provider": "ECMWF/Copernicus CDS",
      "url": "https://cds.climate.copernicus.eu/",
      "resolution_temporal": "hourly",
      "variables": [
        "u10",
        "v10",
        "tp",
        "msl",
        "t2m"
      ]
    }
  },
  "features": [
    "rainfall_mm",
    "rainfall_mean_mm_day",
    "max_daily_rainfall_mm",
    "rainfall_7d_proxy_mm",
    "rainfall_30d_proxy_mm",
    "wind_speed_kmh",
    "wind_dir_deg",
    "pressure_hpa",
    "temp_c"
  ],
  "data_sources": {
    "real": "GPM IMERG + ERA5; retrieval and quality control required",
    "synthetic": "domains/rainfall_weather/data/synthetic/rainfall_weather_monthly_2015_2025.json"
  },
  "limitations": [
    "Monthly values are synthetic summaries, not daily/hourly observations",
    "7/30-day proxy columns are scaled monthly means, not actual rolling sums",
    "Not calibrated against local station data"
  ]
}
